{
  "name": "btc-preco",
  "version": "1.1.0",
  "description": "A project for check btc value",
  "main": "./src/main.js",
  "scripts": {
    "prepush": "npm run coverage",
    "clear": "rimraf bin",
    "build": "npm run clear && ./node_modules/.bin/babel src --out-dir bin --presets=@babel/env",
    "coverage": "nyc --reporter=text --reporter=html npm test",
    "test": "./node_modules/.bin/mocha tests/**/*.spec.js -R progress -r chai/register-expect.js"
  },
  "keywords": [
    "bitcoin",
    "btc"
  ],
  "preferGlobal": true,
  "bin": {
    "btc-preco": "bin/main.js"
  },
  "nyc": {
    "extension": [".js"],
    "require": ["@babel/register"],
    "include": ["src/**/*.js"],
    "exclude": ["tests/**/*.js"],
    "reporter": ["text", "html"],
    "check-coverage": true,
    "lines": 80,
    "functions": 80,
    "branches": 80
  },
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/israelcena/btc-preco.git"
  },
  "author": "IsraelCena",
  "license": "MIT",
  "devDependencies": {
    "@babel/cli": "^8.0.6",
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/register": "^8.0.6",
    "axios-mock-adapter": "^2.1.0",
    "c8": "^12.0.0",
    "chai": "^5.1.0",
    "mocha": "^10.3.0",
    "nock": "^14.0.10",
    "nyc": "^15.1.0",
    "rimraf": "^5.0.5",
    "sinon": "^21.0.0"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.2"
  }
}
